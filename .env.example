# All settings are optional. The build runs fully offline with none of them set.
# Set them in your shell or CI environment; the tool reads environment variables only.

# Which HTML to PDF converter to use: auto, none, weasyprint, wkhtmltopdf or chromium.
# auto tries weasyprint, then wkhtmltopdf, then a Chromium family browser on PATH.
BOOK_PDF_CONVERTER=auto

# Full path to the converter executable when it is not on PATH.
# Only used when BOOK_PDF_CONVERTER names wkhtmltopdf or chromium.
BOOK_PDF_BINARY=
